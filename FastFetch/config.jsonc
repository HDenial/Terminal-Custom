  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "red",
      "title": "red"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "green",
        "yellow": "yellow",
        "red": "red"
      }
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{3} {12}"
    },
    "host",
    {
      "type": "kernel",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "format": "{1} days, {2} hours, {3} mins"
    },
    "packages",
    {
      "type": "shell",
      "format": "{1} {4}"
    },
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    "terminalfont",
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "format": "{1} ({4}) @ {7}GHz"
    },
    {
      "type": "gpu",
